        "import subprocess\n",
        "from pathlib import Path\n",
        "\n",
        "VENV_PY = \"/content/venv/bin/python\"\n",
        "PLUGIN_DIR = Path(\"/content/Spark-plugin\")\n",
        "\n",
        "subprocess.run(\"rm -rf /usr/local/lib/python3.13/dist-packages/~riton*\", shell=True)\n",
        "\n",
        "subprocess.check_call([\"pip\", \"install\", \"-q\", \"-U\", \"uv\"])\n",
        "if not Path(VENV_PY).exists():\n",
        "    subprocess.check_call([\"uv\", \"venv\", \"/content/venv\", \"--python\", \"3.12\", \"--seed\"])\n",
        "\n",
        "r = subprocess.run([\n",
        "    \"uv\", \"pip\", \"install\", \"--python\", VENV_PY,\n",
        "    \"vllm\", \"open-webui\", \"requests\", \"jinja2\",\n",
        "    \"huggingface_hub[hf_transfer]\",\n",
        "], capture_output=True, text=True)\n",
        "if r.stdout: print(r.stdout)\n",
        "if r.returncode != 0:\n",
        "    print(r.stderr)\n",
        "    raise RuntimeError(\"依赖安装失败，把上方 stderr 完整贴出来\")\n",
        "\n",
        "if not PLUGIN_DIR.exists():\n",
        "    subprocess.check_call([\n",
        "        \"git\", \"clone\", \"--depth\", \"1\",\n",
        "        \"https://github.com/XHToken/Spark-plugin.git\",\n",
        "        str(PLUGIN_DIR),\n",
        "    ])\n",
        "subprocess.check_call([\"uv\", \"pip\", \"install\", \"--python\", VENV_PY, str(PLUGIN_DIR)])\n",
        "\n",
        "# mcp 必须放在所有安装的最后：前面任何一步（尤其插件）都可能把它解析成 2.x，\n",
        "# 而 open-webui 只认 1.x（streamablehttp_client 在 2.x 被删了）\n",
        "r = subprocess.run([\n",
        "    \"uv\", \"pip\", \"install\", \"--python\", VENV_PY, \"mcp>=1.8,<2\",\n",
        "], capture_output=True, text=True)\n",
        "if r.stdout: print(r.stdout)\n",
        "if r.returncode != 0:\n",
        "    print(r.stderr)\n",
        "    raise RuntimeError(\n",
        "        \"mcp 锁定失败。如果上方报错提到与 spark-plugin 的依赖冲突，\"\n",
        "        \"把上面装插件那行改成 uv pip install --no-deps 版本后重跑本格\"\n",
        "    )\n",
        "\n",
        "# 硬验证：mcp 必须 1.x 且可导入，vllm 和插件正常，任何一项不满足直接失败\n",
        "r = subprocess.run([VENV_PY, \"-c\",\n",
        "    \"from importlib.metadata import entry_points, version; \"\n",
        "    \"from mcp.client.streamable_http import streamablehttp_client; \"\n",
        "    \"mcp_ver = version('mcp'); \"\n",
        "    \"assert mcp_ver.startswith('1.'), f'mcp 是 {mcp_ver}，必须是 1.x'; \"\n",
        "    \"eps = [(e.name, e.value) for e in entry_points(group='vllm.general_plugins')]; \"\n",
        "    \"import vllm; \"\n",
        "    \"print('vllm', vllm.__version__); \"\n",
        "    \"print('mcp', mcp_ver); \"\n",
        "    \"print('spark2_5 plugin:', ('spark2_5', 'vllm_spark2_5_plugin:register') in eps)\"\n",
        "], capture_output=True, text=True)\n",
        "if r.returncode != 0:\n",
        "    print(r.stderr)\n",
        "    raise RuntimeError(\"环境验证未通过，见上方 stderr\")\n",
        "print(r.stdout)\n",
        "print(\"环境就绪\")\n"
