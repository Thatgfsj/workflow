        "import subprocess, threading, time\n",
        "from pathlib import Path\n",
        "\n",
        "MODEL_ID   = \"XHToken/Spark-X2.6-4B\"\n",
        "MODEL_DIR  = Path(\"/content/models/Spark-X2.6-4B\")\n",
        "MARKER     = MODEL_DIR / \".download_done\"\n",
        "\n",
        "if MARKER.exists() and any(MODEL_DIR.glob(\"*.safetensors\")):\n",
        "    print(\"模型已下载，跳过\")\n",
        "else:\n",
        "    MODEL_DIR.mkdir(parents=True, exist_ok=True)\n",
        "    done = False\n",
        "\n",
        "    def keepalive():\n",
        "        for i in range(1, 10000):\n",
        "            if done: break\n",
        "            print(f\"下载中... 已运行 {i} 分钟\", flush=True)\n",
        "            time.sleep(60)\n",
        "\n",
        "    threading.Thread(target=keepalive, daemon=True).start()\n",
        "\n",
        "    for attempt in range(1, 31):\n",
        "        print(f\"===== 第 {attempt}/30 次尝试 =====\", flush=True)\n",
        "        r = subprocess.run([\n",
        "            \"/content/venv/bin/python\", \"-m\",\n",
        "            \"huggingface_hub.commands.huggingface_cli\",\n",
        "            \"download\", MODEL_ID,\n",
        "            \"--local-dir\", str(MODEL_DIR),\n",
        "            \"--exclude\", \"*.pth\", \"*.onnx\", \"*.msgpack\", \"*.h5\",\n",
        "        ])\n",
        "        if r.returncode == 0:\n",
        "            MARKER.touch()\n",
        "            print(\"模型下载完成\")\n",
        "            break\n",
        "        print(\"中断，15 秒后自动续传...\", flush=True)\n",
        "        time.sleep(15)\n",
        "    else:\n",
        "        raise RuntimeError(\"重试次数用尽，请重跑本单元格\")\n",
        "\n",
        "    done = True\n"
      ],
