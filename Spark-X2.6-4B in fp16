      "cell_type": "code",
      "source": [
        "import os, subprocess, time, urllib.request, secrets, re, json, socket\n",
        "from pathlib import Path\n",
        "\n",
        "VLLM_PORT, WEBUI_PORT = 8000, 3081\n",
        "MODEL_DIR    = Path(\"/content/models/Spark-X2.6-4B\")\n",
        "TEMPLATE     = Path(\"/content/chat_template.jinja\")\n",
        "API_KEY_FILE = Path(\"/content/api_key.txt\")\n",
        "GEN_CFG      = MODEL_DIR / \"generation_config.json\"\n",
        "\n",
        "def wait_ready(url, minutes, log_hint):\n",
        "    for i in range(minutes * 12):\n",
        "        time.sleep(5)\n",
        "        try:\n",
        "            with urllib.request.urlopen(url, timeout=3) as r:\n",
        "                if r.status == 200: return True\n",
        "        except Exception: pass\n",
        "    print(f\"等待超时，查看日志: !tail -n 50 {log_hint}\")\n",
        "    return False\n",
        "\n",
        "def kill_and_wait_port(pattern, port, timeout=15):\n",
        "    \"\"\"杀进程并等端口真正释放，避免 address already in use\"\"\"\n",
        "    subprocess.run(f\"pkill -9 -f '{pattern}' || true\", shell=True)\n",
        "    for _ in range(timeout):\n",
        "        time.sleep(1)\n",
        "        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n",
        "            if s.connect_ex((\"127.0.0.1\", port)) != 0:\n",
        "                return\n",
        "    raise RuntimeError(\n",
        "        f\"端口 {port} 释放超时，另开单元格跑 !lsof -i :{port} -P -n 查看占用者\")\n",
        "\n",
        "print(\"清理旧进程与显存...\", flush=True)\n",
        "subprocess.run(\"pkill -9 -f 'open-webui' || true\", shell=True)\n",
        "subprocess.run(\"pkill -9 -f 'vllm serve' || true\", shell=True)\n",
        "subprocess.run(\"pkill -9 -f 'cloudflared' || true\", shell=True)\n",
        "subprocess.run(\"pkill -9 -f 'EngineCore' || true\", shell=True)\n",
        "\n",
        "r = subprocess.run(\"nvidia-smi --query-compute-apps=pid --format=csv,noheader\",\n",
        "                   shell=True, capture_output=True, text=True)\n",
        "for pid in [p.strip() for p in r.stdout.split() if p.strip()]:\n",
        "    subprocess.run(f\"kill -9 {pid} || true\", shell=True)\n",
        "\n",
        "for _ in range(20):\n",
        "    time.sleep(2)\n",
        "    r = subprocess.run(\n",
        "        \"nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits\",\n",
        "        shell=True, capture_output=True, text=True)\n",
        "    free = int(r.stdout.strip().split(\"\\n\")[0])\n",
        "    print(f\"  空闲显存: {free} MiB\", flush=True)\n",
        "    if free > 13000:\n",
        "        break\n",
        "else:\n",
        "    raise RuntimeError(\"显存未释放，跑 !nvidia-smi 查看占用者\")\n",
        "print(\"清理完成\", flush=True)\n",
        "\n",
        "r = subprocess.run([\"/content/venv/bin/python\", \"-c\",\n",
        "    \"from importlib.metadata import version; \"\n",
        "    \"from mcp.client.streamable_http import streamablehttp_client; \"\n",
        "    \"print(version('mcp'))\"\n",
        "], capture_output=True, text=True)\n",
        "if r.returncode != 0:\n",
        "    raise RuntimeError(\n",
        "        \"mcp 环境损坏（大概率被升回 2.x），先另开单元格跑修复再重跑本格：\\n\"\n",
        "        \"uv pip install --python /content/venv/bin/python 'mcp>=1.8,<2'\"\n",
        "    )\n",
        "print(f\"mcp 预检通过: {r.stdout.strip()}\", flush=True)\n",
        "\n",
        "if GEN_CFG.exists():\n",
        "    cfg = json.loads(GEN_CFG.read_text())\n",
        "    cfg.update({\n",
        "        \"temperature\": 1.05,\n",
        "        \"top_p\": 0.97,\n",
        "        \"top_k\": -1,\n",
        "        \"repetition_penalty\": 1.0,\n",
        "        \"presence_penalty\": 0.1,\n",
        "        \"frequency_penalty\": 0.0,\n",
        "    })\n",
        "    GEN_CFG.write_text(json.dumps(cfg, indent=2, ensure_ascii=False))\n",
        "    print(f\"采样默认值已写入: {GEN_CFG}\")\n",
        "\n",
        "if not TEMPLATE.exists():\n",
        "    urllib.request.urlretrieve(\n",
        "        \"https://huggingface.co/XHToken/Spark-X2.6-4B/resolve/main/chat_template.jinja\",\n",
        "        TEMPLATE)\n",
        "\n",
        "if API_KEY_FILE.exists():\n",
        "    API_KEY = API_KEY_FILE.read_text().strip()\n",
        "else:\n",
        "    API_KEY = secrets.token_hex(16)\n",
        "    API_KEY_FILE.write_text(API_KEY)\n",
        "\n",
        "# ---- 4. 启动 vLLM（上下文 16K，原生工具调用 + cudagraph 提速）----\n",
        "log = open(\"/content/vllm.log\", \"w\")\n",
        "subprocess.Popen([\n",
        "    \"/content/venv/bin/vllm\", \"serve\", str(MODEL_DIR),\n",
        "    \"--port\", str(VLLM_PORT),\n",
        "    \"--trust-remote-code\",\n",
        "    \"--served-model-name\", \"spark2.6\",\n",
        "    \"--gpu-memory-utilization\", \"0.85\",\n",
        "    \"--max-model-len\", \"16384\",\n",
        "    \"--dtype\", \"float16\",\n",
        "    \"--enable-prefix-caching\",\n",
        "    \"--chat-template\", str(TEMPLATE),\n",
        "    \"--api-key\", API_KEY,\n",
        "    \"--enable-auto-tool-choice\",\n",
        "    \"--tool-call-parser\", \"spark25\",\n",
        "], stdout=log, stderr=subprocess.STDOUT)\n",
        "\n",
        "print(\"等待 vLLM 就绪，期间不要打断本格...\", flush=True)\n",
        "if not wait_ready(f\"http://127.0.0.1:{VLLM_PORT}/health\", 15, \"/content/vllm.log\"):\n",
        "    raise RuntimeError(\"vLLM 未就绪，查看 !tail -n 50 /content/vllm.log\")\n",
        "print(\"vLLM 就绪（含原生工具调用）\", flush=True)\n",
        "\n",
        "# ---- 5. 启动 Open WebUI ----\n",
        "SYSTEM_PROMPT = \"\"\"你说话直接、具体、有明确立场。回答时先给结论再给理由，不要用\"可能\"\"建议咨询专业人士\"\"作为语言模型\"这类开场和收尾。不知道就承认不知道，不要用套话回避。允许表达偏好和判断，被反驳时给出论据而不是让步。\n",
        "\n",
        "复杂问题必须先在思考中充分分析：拆解问题、列举方案、权衡利弊，思考完再给出结论，思考的深度和篇幅不受限制，宁可多想不要草率作答。简单问题可以简短思考直接回答。\n",
        "\n",
        "【工具使用规则】当对话上下文中出现可用工具（如网页搜索、代码执行）的定义时：\n",
        "- 涉及实时信息（新闻、天气、最新数据）或你不确定的事实，主动调用搜索工具，不要凭记忆编造。\n",
        "- 涉及计算、数据处理、逻辑验证，使用代码执行工具，不要心算长链推导。\n",
        "- 工具返回结果后基于结果作答，并说明信息来源。\n",
        "- 简单常识问题直接回答，不为用工具而用工具。\"\"\"\n",
        "\n",
        "data_dir = Path(\"/content/open-webui-data\"); data_dir.mkdir(exist_ok=True)\n",
        "os.environ.update({\n",
        "    \"OPENAI_API_BASE_URL\": f\"http://127.0.0.1:{VLLM_PORT}/v1\",\n",
        "    \"OPENAI_API_KEY\":      API_KEY,\n",
        "    \"ENABLE_OPENAI_API\":   \"True\",\n",
        "    \"WEBUI_SECRET_KEY\":    secrets.token_hex(32),\n",
        "    \"DATA_DIR\":            str(data_dir),\n",
        "    \"DEFAULT_MODELS\":      \"spark2.6\",\n",
        "    \"DEFAULT_SYSTEM_PROMPT\": SYSTEM_PROMPT,\n",
        "})\n",
        "kill_and_wait_port(\"open-webui\", WEBUI_PORT)\n",
        "\n",
        "subprocess.Popen(\n",
        "    [\"/content/venv/bin/open-webui\", \"serve\", \"--port\", str(WEBUI_PORT)],\n",
        "    stdout=open(\"/content/webui.log\", \"w\"), stderr=subprocess.STDOUT)\n",
        "\n",
        "print(\"启动 Open WebUI ...\", flush=True)\n",
        "if not wait_ready(f\"http://127.0.0.1:{WEBUI_PORT}/health\", 3, \"/content/webui.log\"):\n",
        "    raise RuntimeError(\"Open WebUI 未就绪，查看 !tail -n 50 /content/webui.log\")\n",
        "print(\"Open WebUI 就绪\", flush=True)\n",
        "\n",
        "# ---- 6. 创建两条公网隧道 ----\n",
        "cf_path = Path(\"/content/cloudflared\")\n",
        "if not cf_path.exists():\n",
        "    urllib.request.urlretrieve(\n",
        "        \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\",\n",
        "        cf_path)\n",
        "    cf_path.chmod(0o755)\n",
        "\n",
        "def create_tunnel(port, name):\n",
        "    log_file = Path(f\"/content/tunnel_{name}.log\")\n",
        "    subprocess.run(f\"pkill -f 'tunnel_{name}' || true\", shell=True)\n",
        "    subprocess.Popen(\n",
        "        [str(cf_path), \"tunnel\", \"--url\", f\"http://127.0.0.1:{port}\"],\n",
        "        stdout=open(log_file, \"w\"), stderr=subprocess.STDOUT)\n",
        "    for _ in range(20):\n",
        "        time.sleep(2)\n",
        "        try:\n",
        "            m = re.search(r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\", log_file.read_text())\n",
        "            if m: return m.group(0)\n",
        "        except Exception: pass\n",
        "    return None\n",
        "\n",
        "webui_url = create_tunnel(WEBUI_PORT, \"webui\")\n",
        "api_url   = create_tunnel(VLLM_PORT, \"api\")\n",
        "\n",
        "print()\n",
        "print(\"=\" * 66)\n",
        "print(f\"Open WebUI : {webui_url}\")\n",
        "print(f\"OpenAI API : {api_url}/v1\")\n",
        "print(f\"模型名     : spark2.6    上下文: 16384\")\n",
        "print(f\"API Key    : {API_KEY}\")\n",
        "print(\"=\" * 66)\n"
      ],
