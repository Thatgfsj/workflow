        "import subprocess, threading, time\n",
        "from pathlib import Path\n",
        "\n",
        "MODEL_ID  = \"abenzerps/Spark-X2.6-4B-Uncensored-GSQ-RCO-GGUF\"\n",
        "MODEL_DIR = Path(\"/content/models/Spark-Uncensored-GSQ-RCO\")\n",
        "GGUF_NAME = \"Spark-X2.6-4B-GSQ-RCO-IQ4_XS.gguf\"\n",
        "MARKER    = MODEL_DIR / \".download_done\"\n",
        "\n",
        "GGUF_FILE = MODEL_DIR / GGUF_NAME\n",
        "\n",
        "# ---- 1. 下载（已存在则跳过）----\n",
        "if MARKER.exists() and GGUF_FILE.exists():\n",
        "    print(f\"✓ 模型已存在: {GGUF_FILE}\")\n",
        "    print(f\"  大小: {GGUF_FILE.stat().st_size / 1024**3:.2f} GB\")\n",
        "else:\n",
        "    MODEL_DIR.mkdir(parents=True, exist_ok=True)\n",
        "    done = False\n",
        "\n",
        "    def keepalive():\n",
        "        for i in range(1, 10000):\n",
        "            if done: break\n",
        "            print(f\"  下载中... 已运行 {i} 分钟\", flush=True)\n",
        "            time.sleep(60)\n",
        "\n",
        "    threading.Thread(target=keepalive, daemon=True).start()\n",
        "\n",
        "    for attempt in range(1, 31):\n",
        "        print(f\"===== 第 {attempt}/30 次尝试 =====\", flush=True)\n",
        "        r = subprocess.run([\n",
        "            \"/content/venv/bin/python\", \"-c\",\n",
        "            f\"from huggingface_hub import hf_hub_download; \"\n",
        "            f\"p = hf_hub_download('{MODEL_ID}', '{GGUF_NAME}', local_dir='{MODEL_DIR}'); \"\n",
        "            f\"print(p)\"\n",
        "        ])\n",
        "        if r.returncode == 0 and GGUF_FILE.exists():\n",
        "            MARKER.touch()\n",
        "            print(f\"✓ 下载完成: {GGUF_FILE}\")\n",
        "            print(f\"  大小: {GGUF_FILE.stat().st_size / 1024**3:.2f} GB\")\n",
        "            break\n",
        "        print(\"  中断，15 秒后重试...\", flush=True)\n",
        "        time.sleep(15)\n",
        "    else:\n",
        "        raise RuntimeError(\"重试次数用尽，请重跑本单元格\")\n",
        "    done = True\n",
        "\n",
        "# ---- 2. 元数据检查：gguf 包直接读文件头（不依赖 llama-server）----\n",
        "print(\"\\n检查 GGUF 元数据（chat_template 是否内嵌）...\", flush=True)\n",
        "subprocess.run([\"uv\", \"pip\", \"install\", \"--quiet\", \"--python\",\n",
        "                \"/content/venv/bin/python\", \"gguf\"], check=True)\n",
        "\n",
        "check_code = f'''\n",
        "from gguf import GGUFReader\n",
        "r = GGUFReader(\"{GGUF_FILE}\")\n",
        "keys = list(r.fields.keys())\n",
        "print(\"总元数据字段数:\", len(keys))\n",
        "\n",
        "# 找 chat_template 相关字段\n",
        "tmpl_keys = [k for k in keys if \"chat_template\" in k.lower()]\n",
        "if not tmpl_keys:\n",
        "    print(\"RESULT: MISSING\")\n",
        "else:\n",
        "    print(\"RESULT: FOUND\", tmpl_keys)\n",
        "    for k in tmpl_keys:\n",
        "        v = r.fields[k]\n",
        "        try:\n",
        "            s = bytes(v.parts[list(v.parts.keys())[0]])\n",
        "            text = s.decode(\"utf-8\", errors=\"replace\")\n",
        "            print(f\"--- {k} 前 400 字符 ---\")\n",
